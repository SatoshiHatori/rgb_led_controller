	(text "1. 入力保護 (ヒューズ・TVS・ローサイド逆接保護)" (exclude_from_sim no) (at 17 23 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "5259c402-c2bf-4839-932b-996802b6dab0"))
	(text "Q1: 逆接時 OFF、ボディダイオードが阻止。R1+R2: 73V 時に 1608 の定格 50V を超えないよう直列。" (exclude_from_sim no) (at 17 85 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "52b26500-4da0-4d09-9be9-3cb216b81d3f"))
	(text "2. 電源 (FET リニアプリレギュレータ → 5V → 3.3V)" (exclude_from_sim no) (at 167 23 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "72c28c41-b123-409f-83bd-8fd7fdd85ca0"))
	(text "VPRE ≈ 15V − VGS(Q5) ≈ 9.5〜13.3V。U4 の損失は最大 約0.5W。入力下限 約13V。" (exclude_from_sim no) (at 167 85 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "42029147-efd8-41eb-b28b-52d9149fac05"))
	(text "6. 取付穴・電源フラグ" (exclude_from_sim no) (at 327 23 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "4abac81b-2769-4212-8b9d-865719c35544"))
	(text "3. マイコン (CH32V203K8T6, CAN 内蔵, 8MHz 水晶)" (exclude_from_sim no) (at 17 100 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "bf964664-b026-4f4a-b29a-294277018dbd"))
	(text "J4 (SWD, WCH-LinkE)、J5 (UART: USART1 PA9=TX / PA10=RX)、J6 (空きポート) は未実装パッド。" (exclude_from_sim no) (at 17 239.5 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7c76d00f-2630-47e3-a9f6-de8ac47f331c"))
	(text "未使用ピンはプルアップ入力に設定。J1, J2 = JST VH / J3 = JST PA (ロック付、耐振動)。" (exclude_from_sim no) (at 17 244 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "85708b64-625d-4482-9118-06504b88fd8e"))
	(text "4. CAN (ATA6561, 既定 500kbit/s, 11bit ID 0x7D0)" (exclude_from_sim no) (at 137 100 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "2ed0e39b-9c37-4b45-a2c9-0f055c4520b1"))
	(text "フレーム: ID 0x7D0, data[0..2]=R,G,B, data[3]=保持時間×100ms (省略/0 = 500ms)。途絶で消灯。" (exclude_from_sim no) (at 137 168 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "43eed0e0-bad8-440e-97fb-77beb6b48f3c"))
	(text "5. LED テープ駆動 (ローサイド N-MOS × 3, 5V ゲート)" (exclude_from_sim no) (at 257 100 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "4270dd12-2bab-4d24-a25f-79a3e29ca706"))
	(text "U3 は 2 段直列で非反転。起動中は R7〜9 と R13〜15 で消灯。" (exclude_from_sim no) (at 257 245 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f018c606-92f1-4ccf-82c7-ab0f22d720df"))
